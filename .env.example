# Copy this file to .env and keep the real value out of Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# MailSafi Postal email delivery
POSTAL_API_KEY=
POSTAL_API_URL=https://postalmail.mailsafi.com/api/v1/send/message
POSTAL_FROM_ADDRESS=no-reply@gs1kenya.org
POSTAL_FROM_NAME=GHCE

# Sentry logger handler is on by default in prod and off elsewhere.
# Set to true/false to override the default for this environment.
SENTRY_LOGGER_ENABLED=

