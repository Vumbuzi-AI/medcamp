<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Service Unavailable - Glocal Health Centre</title>
    <script src="https://cdn.tailwindcss.com">
    </script>
    <script>
      tailwind.config = {
          theme: {
              extend: {
                  colors: {
                      'brand-primary': '#373896',
                      'brand-secondary': '#6667ab',
                      'brand-light': '#f8f8ff',
                      'brand-accent': '#f0f0ff',
                      'brand-border': '#e7e7ff'
                  }
              }
          }
      }
    </script>
  </head>
  <body class="bg-brand-light min-h-screen flex items-center justify-center p-4">
    <div
      id="error-503"
      class="w-full max-w-2xl bg-white rounded-lg shadow-lg border border-gray-100 overflow-hidden "
    >
      <!-- Header -->
      <div class="bg-brand-primary px-6 py-4">
        <div class="flex justify-between items-center">
          <div>
            <h1 class="text-white text-2xl font-bold">Service Unavailable</h1>
            <p class="text-blue-100 text-sm">Glocal Health Centre</p>
          </div>
          <div class="text-right">
            <div class="bg-orange-500 text-white text-xs px-3 py-1 rounded-full font-medium">
              ERROR 503
            </div>
          </div>
        </div>
      </div>
      
<!-- Main Content -->
      <div class="p-6 text-center">
        <!-- Error Icon -->
        <div class="mx-auto flex items-center justify-center h-20 w-20 rounded-full bg-orange-50 border-2 border-orange-200 mb-6">
          <svg
            class="h-10 w-10 text-orange-600"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
            />
          </svg>
        </div>

        <h2 class="text-4xl font-bold text-brand-primary mb-2">503</h2>
        <h3 class="text-xl text-gray-600 mb-4">Service Temporarily Unavailable</h3>
        <p class="text-gray-600 mb-6 max-w-md mx-auto">
          We're currently deploying updates to improve your experience. The service will be back online shortly.
        </p>
        
<!-- Deployment Status -->
        <div class="bg-blue-50 border border-blue-200 rounded-lg p-6 mb-6 text-left">
          <h4 class="text-blue-800 font-semibold mb-3 flex items-center">
            <svg
              class="h-5 w-5 mr-2 animate-spin"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
              />
            </svg>
            Deployment in Progress:
          </h4>
          <ul class="text-blue-700 space-y-2 text-sm">
            <li class="flex items-start">
              <span class="text-blue-500 mr-2">•</span>
              System updates are being deployed to enhance performance
            </li>
            <li class="flex items-start">
              <span class="text-blue-500 mr-2">•</span>
              New features and improvements are being installed
            </li>
            <li class="flex items-start">
              <span class="text-blue-500 mr-2">•</span> Expected completion time: 5-10 minutes
            </li>
          </ul>
        </div>
        
<!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-3 justify-center mb-6">
          <button
            onclick="location.reload()"
            class="inline-flex items-center justify-center px-6 py-3 bg-brand-primary text-white font-medium rounded-lg hover:bg-brand-secondary transition-colors"
          >
            <svg class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
              />
            </svg>
            Refresh Page
          </button>
          <button
            onclick="setTimeout(() => location.reload(), 60000); this.innerHTML = 'Auto-refresh in 60s...'; this.disabled = true;"
            class="inline-flex items-center justify-center px-6 py-3 bg-gray-100 text-gray-700 font-medium rounded-lg hover:bg-gray-200 transition-colors disabled:opacity-50"
          >
            <svg class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
            Auto-refresh
          </button>
        </div>
        
<!-- Contact Information -->
        <div class="bg-gray-50 rounded-lg p-4">
          <h4 class="text-sm font-medium text-gray-900 mb-2">Need Immediate Assistance?</h4>
          <p class="text-sm text-gray-600 mb-3">
            For urgent matters, please contact our support team directly while the deployment is in progress.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center text-sm">
            <a
              href="tel:+254700000000"
              class="text-brand-primary hover:text-brand-secondary flex items-center justify-center"
            >
              <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                />
              </svg>
              Emergency Support
            </a>
            <a
              href="mailto:info@glocalhealthcentre.org"
              class="text-brand-primary hover:text-brand-secondary flex items-center justify-center"
            >
              <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                />
              </svg>
              info@glocalhealthcentre.org
            </a>
          </div>
        </div>
      </div>
      
<!-- Footer -->
      <div class="bg-brand-light px-6 py-4 border-t border-gray-100">
        <div class="text-center text-sm text-gray-500">
          <p>&copy; <span id="year-503">2024</span> Glocal Health Centre. All Rights Reserved.</p>
        </div>
      </div>
    </div>

    <script>
      // Update year automatically
      document.getElementById('year-503').textContent = new Date().getFullYear();

      // Auto-refresh every 2 minutes if page hasn't been manually refreshed
      let autoRefreshTimer = setTimeout(() => {
        location.reload();
      }, 120000);

      // Clear auto-refresh if user manually refreshes
      window.addEventListener('beforeunload', () => {
        clearTimeout(autoRefreshTimer);
      });
    </script>
  </body>
</html>
