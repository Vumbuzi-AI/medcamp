<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta
      name="user-authenticated"
      content={if assigns[:current_user], do: "true", else: "false"}
    />
    <.live_title default={organisation_name(assigns)} suffix=" · GS1 Kenya">
      {assigns[:page_title]}
    </.live_title>
    <meta name="title" content={organisation_name(assigns)} />
    <meta name="robots" content="index, follow" />
    <meta name="twitter:image" content={organisation_logo(assigns)} />
    <meta property="og:image" content={organisation_logo(assigns)} />
    <link rel="icon" type="image/svg+xml" href={organisation_logo(assigns)} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <%!-- The current organisation's palette. Overrides the --brand-* defaults
          in app.css, which is what every brand-* Tailwind class reads. --%>
    <style>
      :root { <%= Phoenix.HTML.raw(Medcamp.Organisations.brand_css(assigns[:current_organisation])) %> }
    </style>
    {Phoenix.HTML.raw(assigns[:head_html] || "")}

    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
    />

    <script src="https://cdn.ckeditor.com/ckeditor5/40.2.0/classic/ckeditor.js">
    </script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js">
    </script>

    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js">
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js">
    </script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js">
    </script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js">
    </script>
  </head>
  <body class={["bg-white", assigns[:body_class]]}>
    <script>
      (function() {
        if (localStorage.getItem("sidebar-collapsed") === "true") {
          document.body.classList.add("sidebar-collapsed");
        }
      })();
    </script>
    {@inner_content}
  </body>
</html>
