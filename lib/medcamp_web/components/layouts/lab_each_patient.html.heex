<main>
  <div>
    <.flash_group flash={@flash} />

    <.mobile_nav_bar />

    <div class="flex min-h-screen flex-col p-4 lg:flex-row">
      <div>
        <.lab_each_patient_sidebar
          current_user={@current_user}
          patient={@patient}
          active_tab={@active_tab}
        />
      </div>
      <div class="layout-content flex-1 min-w-0 overflow-x-auto rounded-lg bg-white p-2 shadow-md md:p-6 lg:ml-72">
        {@inner_content}
      </div>
    </div>
  </div>
</main>
