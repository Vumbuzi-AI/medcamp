<main>
  <div>
    <.flash_group flash={@flash} />

    <.mobile_nav_bar variant="platform" />

    <div class="flex min-h-screen flex-col bg-[#f7f8fb] p-4 lg:flex-row">
      <div>
        <.superadmin_sidebar current_user={@current_user} active_tab={@active_tab} />
      </div>
      <div class="layout-content min-w-0 flex-1 overflow-x-auto bg-slate-50 p-2 md:p-6 lg:ml-64">
        {@inner_content}
      </div>
    </div>
  </div>
</main>
