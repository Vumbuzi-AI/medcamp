<main class="min-h-screen bg-gray-50">
  <.flash_group flash={@flash} />

  <%!-- Top Navbar --%>
  <nav class="bg-white border-b border-gray-200 shadow-sm">
    <div class="w-[90%] mx-auto  px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <%!-- Left: back button + title --%>
        <div class="flex items-center gap-3">
          <%= if assigns[:back_url] do %>
            <a
              href={@back_url}
              class="flex items-center gap-1 text-sm text-gray-600 hover:text-gray-900 font-medium"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 19l-7-7 7-7"
                />
              </svg>
              <span class="hidden sm:inline">Back</span>
            </a>
          <% end %>
          <div class="min-w-0">
            <p class="text-[10px] font-semibold uppercase tracking-[0.08em] text-slate-400">
              Recording into
            </p>
            <%= if assigns[:active_camp] do %>
              <span class="block truncate text-sm font-bold tracking-tight text-brand-primary sm:text-base">
                {@active_camp.name}
              </span>
            <% else %>
              <span class="block truncate text-sm font-bold tracking-tight text-amber-600 sm:text-base">
                No active camp
              </span>
            <% end %>
          </div>
        </div>

        <%!-- Center: nav tabs (hidden on mobile) --%>
        <div class="hidden sm:flex items-center gap-1">
          <a
            href={"/8018/#{@patient.gsrn}/medical-camp"}
            class={"px-4 py-2 text-sm rounded-md font-medium transition-colors " <> if assigns[:active_tab] == :overview, do: "bg-blue-100 text-blue-700", else: "text-gray-600 hover:bg-gray-100"}
          >
            Overview
          </a>
        </div>

        <%!-- Right: scan next patient + logout (hidden on mobile) + hamburger (shown on mobile) --%>
        <div class="flex items-center gap-2">
          <a
            href="/medical-camp/scan"
            class="hidden sm:flex items-center gap-1 text-sm text-white bg-brand-primary hover:bg-[#2a2b73] font-medium rounded-md px-3 py-1.5 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"
              />
            </svg>
            Scan Next Patient
          </a>
          <.link
            href="/users/log_out"
            method="delete"
            class="hidden sm:flex items-center gap-1 text-sm text-red-600 hover:text-red-800 font-medium border border-red-200 rounded-md px-3 py-1.5 hover:bg-red-50 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h6a2 2 0 012 2v1"
              />
            </svg>
            Logout
          </.link>

          <%!-- Mobile hamburger button --%>
          <button
            type="button"
            class="sm:hidden inline-flex items-center justify-center p-2 rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-100 focus:outline-none"
            onclick="document.getElementById('camp-mobile-menu').classList.toggle('hidden')"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"
              />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <%!-- Mobile menu dropdown --%>
    <div id="camp-mobile-menu" class="hidden sm:hidden border-t border-gray-200 bg-white">
      <div class="px-4 py-3 space-y-1">
        <a
          href={"/8018/#{@patient.gsrn}/medical-camp"}
          class={"block px-3 py-2 rounded-md text-base font-medium " <> if assigns[:active_tab] == :overview, do: "bg-blue-100 text-blue-700", else: "text-gray-600 hover:bg-gray-100"}
        >
          Overview
        </a>
        <div class="border-t border-gray-200 pt-2 mt-2">
          <a
            href="/medical-camp/scan"
            class="flex items-center gap-2 px-3 py-2 rounded-md text-base font-medium text-white bg-brand-primary hover:bg-[#2a2b73] mb-2"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"
              />
            </svg>
            Scan Next Patient
          </a>
          <.link
            href="/users/log_out"
            method="delete"
            class="flex items-center gap-2 px-3 py-2 rounded-md text-base font-medium text-red-600 hover:bg-red-50"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h6a2 2 0 012 2v1"
              />
            </svg>
            Logout
          </.link>
        </div>
      </div>
    </div>
  </nav>

  <%!-- Page content --%>
  <div class="w-[90%] mx-auto  px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
    {@inner_content}
  </div>
</main>
