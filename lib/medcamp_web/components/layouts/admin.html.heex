<main>
  <div>
    <.flash_group flash={@flash} />

    <.mobile_nav_bar />
    <%!-- <.stock_alerts_banner
      stock_alerts={@stock_alerts || %{near_expiry: [], below_reorder: []}}
      alert_count={@stock_alert_count || 0}
      context={:admin}
    /> --%>

    <div class="flex p-4 flex-col lg:flex-row min-h-screen">
      <div>
        <.admin_sidebar current_user={@current_user} active_tab={@active_tab} />
      </div>
      <div class="layout-content flex-1 min-w-0 lg:ml-64 md:p-6 p-2 bg-slate-50 overflow-x-auto">
        <%!-- The camp view selector is not a layout-level bar any more. Each
              camp-scoped page renders <.camp_switcher> in its own toolbar (or
              header, on the medical camp dashboard). It stays session-backed,
              so the choice still follows the admin across pages. --%>
        {@inner_content}
      </div>
    </div>
  </div>
</main>
