<main class="min-h-screen bg-slate-50">
  <div>
    <.flash_group flash={@flash} />

    <%!-- <.stock_alerts_banner
      stock_alerts={assigns[:stock_alerts] || %{near_expiry: [], below_reorder: []}}
      alert_count={assigns[:stock_alert_count] || 0}
      context={:pharmacist}
    /> --%>

    <div class="flex flex-col lg:flex-row min-h-screen">
      <.pharmacist_sidebar current_user={@current_user} active_tab={@active_tab} />
      <div class="layout-content flex-1 min-w-0 lg:ml-72 min-h-screen py-6 px-4 md:px-8 overflow-x-auto">
        <div class="max-w-[1600px] mx-auto">
          {@inner_content}
        </div>
      </div>
    </div>
  </div>
</main>
