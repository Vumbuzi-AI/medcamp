<div class="bg-white rounded-lg shadow-sm border border-gray-100 p-4">
  <.header class="text-[#373896] border-b border-gray-100 pb-4 mb-4">
    <div class="flex items-center">
      <.back navigate={~p"/inventory_manager/inventories_received"}>
        Back to inventories received
      </.back>
    </div>
    <:actions>
      <.link
        patch={~p"/inventory_manager/inventories_received/#{@inventory_received}/show/edit"}
        phx-click={JS.push_focus()}
      >
        <.button class="bg-[#6667ab] hover:bg-[#5556a0] mr-2">
          <div class="flex items-center">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4 mr-2"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
              />
            </svg>
            Edit Inventory Item
          </div>
        </.button>
      </.link>

      <.link
        patch={~p"/inventory_manager/inventories_received/#{@inventory_received}/batches"}
        phx-click={JS.push_focus()}
      >
        <.button class="bg-[#6667ab] hover:bg-[#5556a0]">
          <div class="flex items-center">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4 mr-2"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
              />
            </svg>
            View Batches
          </div>
        </.button>
      </.link>
    </:actions>
  </.header>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="space-y-5">
      <div class="bg-gray-50 rounded-lg border border-gray-100 p-4">
        <h3 class="text-lg font-semibold text-[#373896] mb-4">Item Details</h3>

        <div class="space-y-4">
          <div>
            <p class="text-sm text-gray-500 uppercase font-semibold">Brand Name</p>
            <p class="font-medium text-gray-900 mt-1">{@inventory_received.brand_name}</p>
          </div>

          <div>
            <p class="text-sm text-gray-500 uppercase font-semibold">Generic Name</p>
            <p class="font-medium text-gray-900 mt-1">{@inventory_received.generic_name}</p>
          </div>

          <div>
            <p class="text-sm text-gray-500 uppercase font-semibold">GTIN</p>
            <p class="font-medium text-gray-900 mt-1">{@inventory_received.gtin}</p>
          </div>

          <div>
            <p class="text-sm text-gray-500 uppercase font-semibold">Description</p>
            <p class="text-gray-900 mt-1">{@inventory_received.description}</p>
          </div>

          <div>
            <p class="text-sm text-gray-500 uppercase font-semibold">Type</p>
            <span class="inline-block mt-1 px-3 py-1 text-sm rounded-full bg-blue-100 text-blue-800">
              {@inventory_received.type}
            </span>
          </div>

          <div>
            <p class="text-sm text-gray-500 uppercase font-semibold">Category</p>
            <span class="inline-block mt-1 px-3 py-1 text-sm rounded-full bg-blue-100 text-blue-800">
              {@inventory_received.category || "Not Specified"}
            </span>
          </div>
        </div>
      </div>

      <div class="bg-gray-50 rounded-lg border border-gray-100 p-4">
        <h3 class="text-lg font-semibold text-[#373896] mb-4">Location Information</h3>

        <div class="space-y-4">
          <div>
            <p class="text-sm text-gray-500 uppercase font-semibold">Manufacturer</p>
            <span class="inline-block mt-1 px-3 py-1 text-sm rounded-full bg-[#f0f0ff] text-[#373896]">
              {@inventory_received.supplier}
            </span>
          </div>

          <div>
            <p class="text-sm text-gray-500 uppercase font-semibold">Room</p>
            <%= if @inventory_received.room && @inventory_received.room.name do %>
              <span class="inline-block mt-1 px-3 py-1 text-sm rounded-full bg-green-100 text-green-800">
                {@inventory_received.room.name}
              </span>
            <% else %>
              <span class="inline-block mt-1 px-3 py-1 text-sm rounded-full bg-gray-100 text-gray-500">
                Not Assigned
              </span>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div>
      <div class="bg-gray-50 rounded-lg border border-gray-100 p-4 h-full">
        <h3 class="text-lg font-semibold text-[#373896] mb-4">Product Image</h3>

        <div class="flex items-center justify-center">
          <div class="bg-white rounded-lg border border-gray-200 p-4 w-full max-w-sm shadow-sm">
            <%= if @inventory_received.image do %>
              <img
                src={@inventory_received.image}
                alt={@inventory_received.brand_name}
                class="w-full max-h-64 object-contain mx-auto"
              />
            <% else %>
              <div class="h-64 w-full flex items-center justify-center bg-gray-100 rounded-lg">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-20 w-20 text-gray-300"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                  />
                </svg>
              </div>
            <% end %>
            <p class="text-center text-sm text-gray-500 mt-3">{@inventory_received.brand_name}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  
<!-- Issued Transactions Section -->
  <div class="mt-6 bg-white rounded-lg shadow-sm border border-gray-100 p-4">
    <div class="flex items-center justify-between border-b border-gray-100 pb-4 mb-4">
      <h3 class="text-lg font-semibold text-[#373896] flex items-center gap-2">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5 text-[#6667ab]"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
          />
        </svg>
        Issued Transactions
        <span class="ml-1 px-2 py-0.5 text-xs rounded-full bg-[#f0f0ff] text-[#373896]">
          {length(@issued_list)}
        </span>
      </h3>
      <button
        type="button"
        phx-click="clear_filters"
        class="text-sm text-gray-500 hover:text-gray-800 font-medium"
      >
        Clear filters
      </button>
    </div>
    
<!-- Advanced Filters -->
    <form
      phx-change="filter_issued"
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3 mb-4 bg-gray-50 border border-gray-200 rounded-lg p-3"
    >
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Location / Department</label>
        <select
          name="location"
          class="w-full h-9 border border-gray-300 rounded-md px-2 text-sm focus:ring-[#6667ab] focus:border-[#6667ab]"
        >
          <option value="">All locations</option>
          <%= for loc <- ["Pharmacy","Nurse","Laboratory","Reception","Doctor","Theatre","ICU","Maternity","Paediatrics","Physiotherapy","Radiology","Dental","Nutrition","Records","Administration","Security","Maintenance","Kitchen","Laundry","Mortuary","Other"] do %>
            <option value={loc} selected={@filters["location"] == loc}>{loc}</option>
          <% end %>
        </select>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Batch Number</label>
        <input
          type="text"
          name="batch"
          value={@filters["batch"]}
          phx-debounce="300"
          placeholder="Batch or serial..."
          class="w-full h-9 border border-gray-300 rounded-md px-2 text-sm focus:ring-[#6667ab] focus:border-[#6667ab]"
        />
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Assigned To</label>
        <input
          type="text"
          name="assigned_to"
          value={@filters["assigned_to"]}
          phx-debounce="300"
          placeholder="Name or email..."
          class="w-full h-9 border border-gray-300 rounded-md px-2 text-sm focus:ring-[#6667ab] focus:border-[#6667ab]"
        />
      </div>

      <div class="grid grid-cols-2 gap-2">
        <div>
          <label class="block text-xs font-medium text-gray-600 mb-1">Qty Min</label>
          <input
            type="number"
            name="quantity_min"
            value={@filters["quantity_min"]}
            min="0"
            placeholder="Min"
            class="w-full h-9 border border-gray-300 rounded-md px-2 text-sm focus:ring-[#6667ab] focus:border-[#6667ab]"
          />
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-600 mb-1">Qty Max</label>
          <input
            type="number"
            name="quantity_max"
            value={@filters["quantity_max"]}
            min="0"
            placeholder="Max"
            class="w-full h-9 border border-gray-300 rounded-md px-2 text-sm focus:ring-[#6667ab] focus:border-[#6667ab]"
          />
        </div>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Date From</label>
        <input
          type="date"
          name="date_from"
          value={@filters["date_from"]}
          class="w-full h-9 border border-gray-300 rounded-md px-2 text-sm focus:ring-[#6667ab] focus:border-[#6667ab]"
        />
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Date To</label>
        <input
          type="date"
          name="date_to"
          value={@filters["date_to"]}
          class="w-full h-9 border border-gray-300 rounded-md px-2 text-sm focus:ring-[#6667ab] focus:border-[#6667ab]"
        />
      </div>
    </form>
    
<!-- Table -->
    <%= if Enum.empty?(@issued_list) do %>
      <div class="text-center py-8 bg-gray-50 rounded-lg border border-dashed border-gray-300">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="mx-auto h-10 w-10 text-gray-400"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
          />
        </svg>
        <p class="mt-2 text-sm text-gray-500">No issued transactions found.</p>
      </div>
    <% else %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">
                Issued At
              </th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">
                Batch
              </th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">
                Quantity
              </th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">
                Location
              </th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">
                Assigned To
              </th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">
                Description
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 bg-white">
            <%= for ii <- @issued_list do %>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-4 py-3 text-gray-700 whitespace-nowrap">
                  {ii.inserted_at &&
                    Timex.format!(
                      Timex.shift(ii.inserted_at, hours: 3),
                      "%b %d, %Y %H:%M",
                      :strftime
                    )}
                </td>
                <td class="px-4 py-3">
                  <%= if ii.batch do %>
                    <span class="px-2 py-1 text-xs rounded-full bg-[#f0f0ff] text-[#373896]">
                      {ii.batch.batch}
                    </span>
                  <% else %>
                    <span class="text-gray-400">—</span>
                  <% end %>
                </td>
                <td class="px-4 py-3">
                  <span class="px-2 py-1 text-xs rounded-full bg-blue-100 text-blue-800 font-medium">
                    {ii.quantity} units
                  </span>
                </td>
                <td class="px-4 py-3">
                  <span class="px-2 py-1 text-xs rounded-full bg-green-100 text-green-800">
                    {ii.location}
                  </span>
                </td>
                <td class="px-4 py-3 text-gray-700">
                  <%= if ii.assigned_to do %>
                    <div class="flex items-center gap-2">
                      <div class="h-6 w-6 rounded-full bg-[#e7e7ff] flex items-center justify-center text-[#373896] text-xs font-medium flex-shrink-0">
                        {String.first(ii.assigned_to.email || "?")}
                      </div>
                      <span class="text-sm">{ii.assigned_to.email}</span>
                    </div>
                  <% else %>
                    <span class="text-gray-400">—</span>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-gray-600 max-w-xs truncate">
                  {ii.description || "—"}
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      
<!-- Summary row -->
      <div class="mt-3 pt-3 border-t border-gray-100 flex items-center gap-6 text-sm text-gray-500">
        <span>
          Total issued:
          <strong class="text-gray-800">
            {Enum.sum(Enum.map(@issued_list, & &1.quantity))} units
          </strong>
        </span>
        <span>
          Transactions: <strong class="text-gray-800">{length(@issued_list)}</strong>
        </span>
      </div>
    <% end %>
  </div>

  <.modal
    :if={@live_action == :edit}
    id="inventory_received-modal"
    show
    on_cancel={JS.patch(~p"/inventory_manager/inventories_received/#{@inventory_received}")}
  >
    <.live_component
      module={MedcampWeb.InventoryReceivedLive.FormComponent}
      id={@inventory_received.id}
      title={@page_title}
      action={@live_action}
      current_user={@current_user}
      inventory_received={@inventory_received}
      patch={~p"/inventory_manager/inventories_received/#{@inventory_received}"}
    />
  </.modal>
</div>
