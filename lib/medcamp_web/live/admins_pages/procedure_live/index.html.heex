<div class="bg-white rounded-lg shadow-sm border border-gray-100 p-4">
  <.page_header
    icon_path="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
    title="Procedures"
    subtitle="Search and manage nurse procedures."
  >
    <:actions>
      <.link patch={~p"/admin/procedure/new"}>
        <.button class="bg-[#6667ab] hover:bg-[#5556a0]">
          <div class="flex items-center">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4 mr-2"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 4v16m8-8H4"
              />
            </svg>
            New Procedure
          </div>
        </.button>
      </.link>
    </:actions>
  </.page_header>

  <form phx-change="apply_filters" class="mb-6">
    <.search_input name="filters[search]" value={@filters.search} placeholder="Search by name" />
  </form>

  <.table id="procedure" rows={@procedure_collection}>
    <:empty_state>
      <tr>
        <td class="px-6 py-4 text-sm">
          <p class="font-semibold text-gray-900">
            {if @filters.search != "",
              do: "No procedures match the current filters",
              else: "No procedures available"}
          </p>
          <p class="mt-1 text-sm text-gray-400">—</p>
        </td>
        <td class="px-6 py-4 text-sm text-gray-400">—</td>
        <td class="px-6 py-4 text-sm text-gray-400">—</td>
        <td class="px-6 py-4 text-sm text-gray-400">—</td>
      </tr>
    </:empty_state>

    <:col :let={procedure} label="Name">
      <div class="flex items-center py-3">
        <div class="h-8 w-8 rounded-full bg-[#e7e7ff] flex items-center justify-center text-[#373896] font-medium mr-2 text-sm">
          {String.first(procedure.name || "")}
        </div>
        <span class="font-medium text-gray-900">
          {procedure.name}
        </span>
      </div>
    </:col>

    <:col :let={procedure} label="Price">
      <div class="flex items-center py-3">
        <span class="font-medium text-gray-900">
          KES {procedure.price} /=
        </span>
      </div>
    </:col>

    <:col :let={procedure} label="Description">
      <div class="max-w-xs py-3">
        <span class="text-gray-700 line-clamp-2">{procedure.description}</span>
      </div>
    </:col>

    <:action :let={procedure}>
      <div class="flex items-center justify-center">
        <.link
          patch={~p"/admin/procedure/#{procedure}/edit"}
          class="flex items-center text-[#6667ab] hover:text-[#373896]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 mr-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
            />
          </svg>
          Edit
        </.link>
      </div>
    </:action>

    <:action :let={procedure}>
      <div class="flex items-center justify-center">
        <.link
          phx-click={JS.push("delete", value: %{id: procedure.id})}
          data-confirm="Are you sure?"
          class="flex items-center text-red-600 hover:text-red-800"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 mr-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
            />
          </svg>
          Delete
        </.link>
      </div>
    </:action>
  </.table>

  <.pagination
    page={@page}
    total_pages={@total_pages}
    total_count={@total_count}
    per_page={@per_page}
    show_when_empty={true}
  />

  <.modal
    :if={@live_action in [:new, :edit]}
    id="procedure-modal"
    show
    on_cancel={JS.patch(~p"/admin/procedure")}
  >
    <.live_component
      module={MedcampWeb.ProcedureLive.FormComponent}
      id={@procedure.id || :new}
      title={@page_title}
      action={@live_action}
      current_user={@current_user}
      procedure={@procedure}
      patch={~p"/admin/procedure"}
    />
  </.modal>
</div>
