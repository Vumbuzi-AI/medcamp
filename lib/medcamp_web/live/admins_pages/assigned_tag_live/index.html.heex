<div class="bg-white rounded-lg shadow-sm border border-gray-100 p-4">
  <.header class="text-[#373896] border-b border-gray-100 pb-4 mb-4">
    <div class="flex items-center">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5 mr-2 text-[#6667ab]"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"
        />
      </svg>
      Listing Assigned Tags
    </div>
    <:actions>
      <.link patch={~p"/admin/assigned_tags/new"}>
        <.button class="bg-[#373896] hover:bg-[#2d2e7a] text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors duration-200">
          New Assigned Tag
        </.button>
      </.link>
    </:actions>
  </.header>

  <.blank_state
    :if={@total_count == 0}
    icon_path="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"
    title="No assigned tags found"
    description="No tags have been assigned yet."
  />

  <.table :if={@total_count > 0} id="assigned_tags" rows={@assigned_tags}
    row_id={&"assigned_tags-#{&1.id}"}
  >
    <:col :let={assigned_tag} label="Assigned Number">
      <div class="flex items-center p-3">
        <div class="p-2 rounded-full bg-[#e7e7ff] flex items-center justify-center text-[#373896] font-medium mr-2 text-sm">
          {assigned_tag.number}
        </div>
      </div>
    </:col>

    <:col :let={assigned_tag} label="Date">
      <div class="flex items-center py-3">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4 mr-1 text-[#6667ab]"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 002 2v12a2 2 0 002 2z"
          />
        </svg>
        <span class="text-gray-700">{assigned_tag.date}</span>
      </div>
    </:col>

    <:col :let={assigned_tag} label="Remaining Number">
      <div class="flex items-center  p-3">
        <%= if assigned_tag.remaining_number > 0 do %>
          <span class="px-2 py-1 text-xs rounded-full bg-green-100 text-green-700 font-medium">
            {assigned_tag.remaining_number} remaining
          </span>
        <% else %>
          <span class="px-2 py-1 text-xs rounded-full bg-red-100 text-red-700 font-medium">
            None remaining
          </span>
        <% end %>
      </div>
    </:col>

    <:action :let={assigned_tag}>
      <.link
        patch={~p"/admin/assigned_tags/#{assigned_tag}/edit"}
        class="text-[#373896] hover:text-[#2d2e7a] font-medium text-sm transition-colors duration-200"
      >
        Edit
      </.link>
    </:action>

    <:action :let={assigned_tag}>
      <.link
        phx-click={JS.push("delete", value: %{id: assigned_tag.id}) |> hide("#assigned_tags-#{assigned_tag.id}")}
        data-confirm="Are you sure?"
        class="text-red-600 hover:text-red-800 font-medium text-sm ml-3 transition-colors duration-200"
      >
        Delete
      </.link>
    </:action>
  </.table>
  <.pagination
    page={@page}
    total_pages={@total_pages}
    total_count={@total_count}
    per_page={@per_page}
  />
</div>

<.modal
  :if={@live_action in [:new, :edit]}
  id="assigned_tag-modal"
  show
  on_cancel={JS.patch(~p"/admin/assigned_tags")}
>
  <.live_component
    module={MedcampWeb.AssignedTagLive.FormComponent}
    id={@assigned_tag.id || :new}
    title={@page_title}
    action={@live_action}
    assigned_tag={@assigned_tag}
    patch={~p"/admin/assigned_tags"}
  />
</.modal>
