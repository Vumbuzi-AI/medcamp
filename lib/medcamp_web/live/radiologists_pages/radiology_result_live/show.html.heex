<div class="container mx-auto px-4 py-6">
  <div class="mb-4">
    <.link
      navigate={~p"/radiologist/radiology_results"}
      class="inline-flex items-center text-sm text-blue-600 hover:text-blue-800"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4 mr-1"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M10 19l-7-7m0 0l7-7m-7 7h18"
        />
      </svg>
      Back to all requests
    </.link>
  </div>

  <div class="bg-white rounded-lg shadow-md border border-gray-200 overflow-hidden">
    <div class="px-6 py-4 bg-gradient-to-r from-slate-50 to-purple-100 border-b border-gray-200">
      <div class="flex justify-between items-center">
        <h2 class="text-xl font-semibold text-purple-800">Radiology Request</h2>
        <span class="px-3 py-1 bg-purple-100 text-purple-800 rounded-full text-sm font-medium">
          {@radiology_result.urgency}
        </span>
      </div>
    </div>

    <div class="p-6">
      <div class="mb-6 bg-gray-50 rounded-lg p-4 border border-gray-200">
        <h3 class="text-lg font-medium text-gray-900 mb-2">Patient Information</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <p class="text-sm text-gray-500">Name</p>
            <p class="font-medium">
              {[
                @radiology_result.patient.first_name,
                @radiology_result.patient.middle_name,
                @radiology_result.patient.last_name
              ]
              |> Enum.filter(&(&1 != nil))
              |> Enum.join(" ")}
            </p>
          </div>
          <div>
            <p class="text-sm text-gray-500">Patient ID</p>
            <p class="font-medium">{@radiology_result.patient.gsrn}</p>
          </div>
          <div>
            <p class="text-sm text-gray-500">Gender / Age</p>
            <p class="font-medium">
              {@radiology_result.patient.gender} / {@radiology_result.patient.age} years
            </p>
          </div>
          <div>
            <p class="text-sm text-gray-500">Date of Birth</p>
            <p class="font-medium">{@radiology_result.patient.date_of_birth}</p>
          </div>
        </div>
      </div>

      <div class="mb-6">
        <h3 class="text-lg font-medium text-gray-900 mb-2">Request Details</h3>
        <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
          <div class="mb-4">
            <p class="text-sm text-gray-500 mb-1">Description</p>
            <p class="whitespace-pre-line">{@radiology_result.description}</p>
          </div>

          <div class="mb-4">
            <p class="text-sm text-gray-500 mb-1">Requested Scans</p>
            <div class="bg-white rounded border border-gray-200">
              <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                  <tr>
                    <th
                      scope="col"
                      class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                    >
                      Scan Name
                    </th>
                    <th
                      scope="col"
                      class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"
                    >
                      Price
                    </th>
                  </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                  <%= for scan <- @radiology_result.scans do %>
                    <tr>
                      <td class="px-4 py-3 text-sm text-gray-900">{scan.name}</td>
                      <td class="px-4 py-3 text-sm text-gray-900 text-right">KSh {scan.price}</td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <p class="text-sm text-gray-500">Requested By</p>
              <p class="font-medium">Dr. {@radiology_result.doctor.name}</p>
            </div>
            <div>
              <p class="text-sm text-gray-500">Request Date</p>
              <p class="font-medium">
                {Calendar.strftime(@radiology_result.inserted_at, "%d %b %Y, %H:%M")}
              </p>
            </div>
            <div>
              <p class="text-sm text-gray-500">Payment Status</p>
              <p class="font-medium flex items-center">
                <%= if @radiology_result.has_paid do %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                    <svg
                      class="-ml-0.5 mr-1.5 h-2 w-2 text-green-400"
                      fill="currentColor"
                      viewBox="0 0 8 8"
                    >
                      <circle cx="4" cy="4" r="3" />
                    </svg>
                    Paid
                  </span>
                <% else %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                    <svg
                      class="-ml-0.5 mr-1.5 h-2 w-2 text-red-400"
                      fill="currentColor"
                      viewBox="0 0 8 8"
                    >
                      <circle cx="4" cy="4" r="3" />
                    </svg>
                    Unpaid
                  </span>
                <% end %>
              </p>
            </div>
          </div>
        </div>
      </div>

      <.form for={@form} phx-submit="save" phx-change="validate" class="space-y-6">
        <div>
          <h3 class="text-lg font-medium text-gray-900 mb-4">Enter Radiology Results</h3>

          <div class="mb-4">
            <.input
              field={@form[:findings]}
              type="textarea"
              label="Findings"
              required={true}
              rows={5}
              placeholder="Enter detailed findings from the radiological examination"
            />
          </div>

          <div :if={@radiology_result.radiology_report} class="mb-4">
            <a
              href={@radiology_result.radiology_report}
              download
              class="text-sm text-blue-600 hover:text-blue-800"
            >
              Download Existing Report
            </a>
          </div>

          <.live_file_input upload={@uploads.radiology_report} required />

          <section phx-drop-target={@uploads.radiology_report.ref}>
            <article :for={entry <- @uploads.radiology_report.entries} class="upload-entry">
              <figure>
                <.live_img_preview :if={entry.client_type != "application/pdf"} entry={entry} />
                <figcaption>{entry.client_name}</figcaption>
              </figure>

              <progress value={entry.progress} max="100">{entry.progress}%</progress>

              <button
                type="button"
                phx-click="cancel-upload"
                phx-value-ref={entry.ref}
                aria-label="cancel"
              >
                &times;
              </button>

              <p
                :for={err <- upload_errors(@uploads.radiology_report, entry)}
                class="alert alert-danger"
              >
                {error_to_string(err)}
              </p>
            </article>

            <p :for={err <- upload_errors(@uploads.radiology_report)} class="alert alert-danger">
              {error_to_string(err)}
            </p>
          </section>

          <div class="mt-6 flex justify-end space-x-3">
            <.button
              type="submit"
              class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-purple-600 hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-500"
            >
              Submit Results
            </.button>
          </div>
        </div>
      </.form>
    </div>
  </div>
</div>
